# Procfile for local development with overmind
# Infrastructure runs in Docker, app services run locally
# Usage: overmind start -f Procfile.dev
#
# Environment variables are loaded from .env by shell.nix shellHook

# Backend API (FastAPI with uvicorn hot-reload)
# Loads .env automatically via shell environment
backend: cd backend && poetry run uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload

# Frontend (Svelte with Vite hot-reload)
frontend: cd frontend && pnpm dev --host 0.0.0.0 --port 5173

# ML Worker (Celery for background tasks with hot-reload)
# watchfiles monitors app/ directory and restarts worker on changes
worker: cd backend && poetry run watchfiles --filter python 'poetry run celery -A app.adapters.inbound.workers.celery_app worker --loglevel=info --concurrency=2 --pool=solo' app
