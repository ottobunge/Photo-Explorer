# Test Environment Configuration
# These settings override .env when running tests

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/photo_explorer_test
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/photo_explorer_test

# Qdrant
QDRANT_URL=http://localhost:6334
QDRANT_PHOTOS_COLLECTION=test_photos
QDRANT_FACES_COLLECTION=test_faces

# Redis (Celery broker)
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# Storage
STORAGE_BASE_PATH=/tmp/photo-explorer-test/storage
PHOTO_STORAGE_PATH=/tmp/photo-explorer-test/storage/photos
THUMBNAIL_STORAGE_PATH=/tmp/photo-explorer-test/storage/thumbnails
FACE_STORAGE_PATH=/tmp/photo-explorer-test/storage/faces

# Token Storage
TOKEN_STORAGE_PATH=/tmp/photo-explorer-test/tokens
TOKEN_ENCRYPTION_KEY=test-encryption-key-32-chars-min

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_FACE_DETECTION=true
ENABLE_OBJECT_DETECTION=false
ENABLE_SCENE_CLASSIFICATION=false

# Test Mode Flag
TEST_MODE=true
