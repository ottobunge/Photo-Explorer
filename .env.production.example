# =============================================================================
# Photo Explorer - Production Environment Configuration
# =============================================================================
#
# This file contains all environment variables required for production deployment.
# Copy this file to .env.production and fill in your actual values.
#
# SECURITY WARNING: Never commit .env.production to version control!
# Add it to .gitignore to prevent accidental commits.
#
# =============================================================================

# =============================================================================
# REQUIRED - Application Must-Haves
# =============================================================================

# Security: Token Encryption Key (REQUIRED)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key encrypts OAuth tokens in the database. Keep it secret and backed up!
# WARNING: Changing this key will invalidate all stored OAuth tokens
TOKEN_ENCRYPTION_KEY=

# Environment (REQUIRED)
# Set to "production" to enable production mode and validations
ENVIRONMENT=production

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================

# PostgreSQL Database
# Use a strong password in production!
POSTGRES_USER=photo_explorer
POSTGRES_PASSWORD=
POSTGRES_DB=photo_explorer

# Database Connection URL
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# The asyncpg driver is required for async operations
DATABASE_URL=postgresql+asyncpg://photo_explorer:YOUR_PASSWORD@postgres:5432/photo_explorer

# Database Pool Settings (optional - defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# =============================================================================
# Message Queue Configuration (REQUIRED)
# =============================================================================

# Redis URL for Celery broker and result backend
# Format: redis://HOST:PORT/DB
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Vector Database Configuration (REQUIRED)
# =============================================================================

# Qdrant vector database URL
# Used for semantic search and face clustering
QDRANT_URL=http://qdrant:6333

# Collection names (optional - defaults shown)
# QDRANT_COLLECTION_PHOTOS=photo_embeddings
# QDRANT_COLLECTION_FACES=face_embeddings

# =============================================================================
# Storage Configuration (REQUIRED)
# =============================================================================

# Base directory for file storage (photos, thumbnails, faces)
# In production, use a persistent volume or object storage path
DATA_DIR=/app/storage
STORAGE_PATH=/app/storage

# Thumbnail and face crop paths (optional - defaults to subdirs of STORAGE_PATH)
# THUMBNAILS_PATH=/app/storage/thumbnails
# FACES_PATH=/app/storage/faces

# Maximum upload size in MB (optional - default: 50)
# MAX_UPLOAD_SIZE_MB=50

# =============================================================================
# ML Model Configuration (REQUIRED)
# =============================================================================

# Directory for downloaded ML models
# Ensure this is on a persistent volume to avoid re-downloading models
MODELS_PATH=/app/models

# CLIP model for semantic search (optional - defaults shown)
# CLIP_MODEL_NAME=ViT-L-14
# CLIP_PRETRAINED=openai

# Vision model for photo descriptions (optional)
# Options: blip2, moondream
# VISION_MODEL=blip2

# HuggingFace token (optional - required for gated models only)
# Get from: https://huggingface.co/settings/tokens
# HF_TOKEN=

# =============================================================================
# Google OAuth Configuration (REQUIRED for Google Photos connector)
# =============================================================================

# Web client (frontend OAuth redirect - no secret needed for implicit flow)
# Get from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_OAUTH_WEB_CLIENT_ID=

# Desktop/Server client (backend Celery worker - needs secret for token refresh)
# Create a "Desktop" type OAuth client in Google Cloud Console
GOOGLE_API_CLIENT_ID=
GOOGLE_API_CLIENT_SECRET=

# =============================================================================
# Security Configuration
# =============================================================================

# Allowed local connector paths (optional - defaults to user home directory)
# Comma-separated list of absolute paths that local connectors can access
# Prevents path traversal attacks by restricting filesystem access
# ALLOWED_LOCAL_CONNECTOR_PATHS=/home/user/photos,/mnt/nas/photos

# =============================================================================
# Observability Configuration (OPTIONAL)
# =============================================================================

# Grafana admin password (optional - default: admin)
# IMPORTANT: Change this in production!
GRAFANA_PASSWORD=

# Prometheus retention period (optional - default: 30d)
# Set in prometheus.yml command args

# =============================================================================
# Application Settings (OPTIONAL)
# =============================================================================

# Application name (optional - default: "Photo Explorer")
# APP_NAME=Photo Explorer

# Debug mode (optional - default: false in production)
# WARNING: Never enable debug mode in production!
# DEBUG=false

# Auto-reload on code changes (optional - default: false in production)
# WARNING: Never enable reload in production!
# RELOAD=false

# API version prefix (optional - default: /api/v1)
# API_V1_PREFIX=/api/v1

# =============================================================================
# Image Processing Settings (OPTIONAL)
# =============================================================================

# Thumbnail size in pixels (optional - default: 400x400)
# THUMBNAIL_SIZE=400,400

# Face crop size in pixels (optional - default: 160x160)
# FACE_CROP_SIZE=160,160

# =============================================================================
# Production Checklist
# =============================================================================
#
# Before deploying to production, ensure:
#
# [REQUIRED]
# [ ] TOKEN_ENCRYPTION_KEY is set and backed up securely
# [ ] POSTGRES_PASSWORD is strong and unique
# [ ] GRAFANA_PASSWORD is strong and unique
# [ ] GOOGLE_OAUTH_WEB_CLIENT_ID is configured
# [ ] GOOGLE_API_CLIENT_ID and SECRET are configured
# [ ] ENVIRONMENT=production
# [ ] DEBUG=false (or not set)
# [ ] RELOAD=false (or not set)
#
# [RECOMMENDED]
# [ ] Database backups are configured
# [ ] Volumes are on persistent storage
# [ ] SSL/TLS certificates are configured (reverse proxy)
# [ ] Firewall rules are configured
# [ ] Resource limits are appropriate for your hardware
# [ ] Monitoring dashboards are accessible
# [ ] Log aggregation is configured
#
# =============================================================================
