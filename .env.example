# Photo Explorer Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Google OAuth Configuration
# =============================================================================

# Web client (frontend OAuth redirect - no secret needed for implicit flow)
# Get this from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_OAUTH_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Desktop/Server client (backend Celery worker - needs secret for token refresh)
# Create a "Desktop" type OAuth client in Google Cloud Console
GOOGLE_API_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GOOGLE_API_CLIENT_SECRET=your-client-secret

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=photo_explorer

# PostgreSQL connection URL (async driver) - constructed from above in docker-compose
DATABASE_URL=postgresql+asyncpg://postgres:changeme_in_production@localhost:5432/photo_explorer

# =============================================================================
# Message Queue Configuration
# =============================================================================

# Redis URL for Celery broker and result backend
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Vector Database Configuration
# =============================================================================

# Qdrant vector database URL
QDRANT_URL=http://localhost:6333

# =============================================================================
# Storage Configuration
# =============================================================================

# Base directory for file storage (photos, thumbnails, etc.)
DATA_DIR=./data

# =============================================================================
# Security Configuration
# =============================================================================

# Token encryption key for OAuth token storage (Fernet key) - REQUIRED
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Do not commit this value to version control!
TOKEN_ENCRYPTION_KEY=generate_me_with_command_above

# =============================================================================
# ML Model Configuration
# =============================================================================

# CLIP model for semantic search
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai

# Vision model for photo descriptions
# Options: blip2, moondream
VISION_MODEL=blip2

# HuggingFace token (required for gated models)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=

# =============================================================================
# Optional: Development Settings
# =============================================================================

# Set to "development" for debug mode
# ENVIRONMENT=development

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
